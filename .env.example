# Resend is called server-side; do not expose this key with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=re_replace_with_your_test_or_production_key
# This must use a domain verified in your Resend account.
RESEND_FROM="Mercury Security <security@your-verified-domain.com>"
# Optional in local development. Use a high-entropy secret in production.
OTP_SECRET=replace_with_a_long_random_secret

# --- Client provisioning bridge (external funnel -> admin access) ---
# Shared bearer secret the /api/provisioning/* endpoints require. Use a long
# random value; must be at least 16 characters. The LT funnel must send the
# same value.
PROVISIONING_SHARED_SECRET=replace_with_a_long_random_secret
# Test override: minutes before sending (wins over the hours value below when set).
# PROVISIONING_DELAY_MINUTES=1
# Hours between creating the access and sending the credentials email.
PROVISIONING_DELAY_HOURS=3
# Sign-in page the credentials email links to.
PROVISIONING_LOGIN_URL=http://client.localhost:3210/login
# Sender identity for the credentials email. It is sent on behalf of the
# lottery, so use the lottery's verified sender rather than the bank's.
PROVISIONING_EMAIL_FROM="Programme IA 2026 <confirmation@your-verified-domain.com>"
PROVISIONING_EMAIL_REPLY_TO=support@your-verified-domain.com
